{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for the OOOSplat desktop window. Grants access to the dialog plugin (file picker) and the opener plugin (open PLY files in the OS shell).",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:default",
    "core:webview:default",
    "core:app:default",
    "core:resources:default",
    "core:menu:default",
    "core:tray:default",
    "core:path:default",
    "dialog:default",
    "opener:default"
  ]
}
